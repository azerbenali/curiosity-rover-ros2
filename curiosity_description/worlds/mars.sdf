<?xml version="1.0"?>
<!--
  Mars test site (GENERATED). 100 x 100 m driveable terrain with hills, craters and a
  ridge, ~800 small rocks, 29 boulders, 51 mid/big rock obstacles in 6 mineral colours,
  a dark dune field and 6 sand patches, horizon terrain and a
  butterscotch sky. Mars gravity. The rover spawns in a flat, rock-free zone at the origin.
-->
<sdf version="1.10">
  <world name="mars">
    <physics name="1ms" type="dart">
      <dart><collision_detector>bullet</collision_detector></dart>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -3.721</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.55 0.42 0.34 1</ambient>
      <background>0.84 0.66 0.50 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- low afternoon sun, slightly warm -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>1.0 0.93 0.84 1</diffuse>
      <specular>0.25 0.22 0.2 1</specular>
      <direction>-0.55 0.35 -0.55</direction>
    </light>

    <model name="terrain"><static>true</static><pose>0 0 0 0 0 0</pose><link name="link"><visual name="visual"><cast_shadows>true</cast_shadows><geometry><mesh><uri>mars/terrain.dae</uri></mesh></geometry></visual><collision name="collision"><geometry><mesh><uri>mars/terrain.dae</uri></mesh></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision></link></model>
    <model name="terrain_far"><static>true</static><pose>0 0 0 0 0 0</pose><link name="link"><visual name="visual"><cast_shadows>true</cast_shadows><geometry><mesh><uri>mars/terrain_far.dae</uri></mesh></geometry></visual></link></model>
    <model name="sky"><static>true</static><pose>0 0 0 0 0 0</pose><link name="link"><visual name="visual"><cast_shadows>false</cast_shadows><geometry><mesh><uri>mars/sky.dae</uri></mesh></geometry></visual></link></model>
    <model name="rock_field_0"><static>true</static><pose>0 0 0 0 0 0</pose><link name="link"><visual name="visual"><cast_shadows>true</cast_shadows><geometry><mesh><uri>mars/rock_field_0.dae</uri></mesh></geometry></visual><collision name="collision"><geometry><mesh><uri>mars/rock_field_0.stl</uri></mesh></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision></link></model>
